# Appium / dispositivo
APPIUM_URL=http://127.0.0.1:4723
HAPPFE_PLATFORM=Android
HAPPFE_DEVICE=Android Emulator
HAPPFE_UDID=
HAPPFE_APP_PACKAGE=br.com.emeraldindigo.happfe
HAPPFE_APP_ACTIVITY=br.com.emeraldindigo.happfe.MainActivity
HAPPFE_NO_RESET=false
HAPPFE_AUTO_GRANT_PERMISSIONS=true
HAPPFE_WAIT_SECONDS=30
HAPPFE_SHORT_WAIT_SECONDS=3

# Dados de teste — nunca use produção
HAPPFE_TEST_EMAIL_DOMAIN=example.test
HAPPFE_TEST_PHONE=
HAPPFE_NEW_USER_TEST_PASSWORD=
HAPPFE_TEST_EMAIL=
HAPPFE_TEST_PASSWORD=
HAPPFE_TEST_OTP=

# Compra em staging
HAPPFE_DELIVERY_ADDRESS=
HAPPFE_TEST_PRODUCT=
# Só habilitar quando existir endpoint real de cancelamento/limpeza
HAPPFE_ORDER_CLEANUP_ENABLED=false
